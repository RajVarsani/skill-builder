{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "installCommand": "bun install",
    "buildCommand": "echo 'skip build'"
  },
  "deploy": {
    "startCommand": "bun run apps/api/src/index.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
