{
  "installCommand": "bun install",
  "buildCommand": "bun run --filter web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/profile/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|WhatsApp|Discordbot|TelegramBot).*"
        }
      ],
      "destination": "https://actingas-api.onrender.com/profile/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.actingas.me/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
